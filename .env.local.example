# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Chave de serviço (Service Role) — NUNCA leva o prefixo NEXT_PUBLIC_,
# fica só no servidor. Usada pelo painel administrativo (/admin) para
# ler e gravar dados ignorando as políticas de RLS.
# Supabase → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico-secreta

# Senha de acesso ao painel administrativo (/admin)
ADMIN_PASSWORD=escolha-uma-senha-forte
